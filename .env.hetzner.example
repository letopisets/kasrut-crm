# Copy to .env.hetzner on the Hetzner server and fill real values.

NGINX_PORT=80

POSTGRES_DB=kashrutcrm_db
POSTGRES_USER=kasrut
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The API refuses to start with a placeholder or low-entropy secret.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out (all JWT signing keys are derived from it).
JWT_SECRET=replace-with-at-least-32-random-characters

# Sessions: 15-minute access tokens renewed by a rotating refresh cookie; a
# sign-in lasts 30 days however often it is renewed; cookies are Secure
# (production is HTTPS).
# These are the defaults, and the api service only sees them once
# docker-compose.yml forwards them (see docs/deployment/hetzner.md#sessions-and-refresh-cookies).
# JWT_EXPIRES_IN is no longer read: leave it out.
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_SECURE=true

# AES-256-GCM key for 2FA secret encryption — must be exactly 64 hex characters
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-chars

CORS_ORIGINS=https://mykoshermap.com,https://crm.mykoshermap.com,https://api.mykoshermap.com

# Mandatory 2FA for CRM owners; the API defaults to true when unset. See
# docs/deployment/hetzner.md#mandatory-2fa-for-crm-owners before changing it.
# REQUIRE_OWNER_2FA=true

RUN_MIGRATIONS=true
SEED_DB=false

GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=https://mykoshermap.com/

# Optional geocoders (server-side, api service only — no map rebuild, no CSP change).
# LocationIQ: key from https://locationiq.com/ (free tier ~5k/day). Empty → Nominatim.
LOCATIONIQ_API_KEY=
# GovMap (Survey of Israel): tried first for Israeli addresses. Token from the
# govmap.gov.il personal area (API management), bound to mykoshermap.com (+www).
# GOVMAP_ORIGIN defaults to https://mykoshermap.com. Empty key → LocationIQ/Nominatim only.
GOVMAP_API_KEY=

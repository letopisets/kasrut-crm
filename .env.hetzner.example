# Copy to .env.hetzner on the Hetzner server and fill real values.

NGINX_PORT=80

POSTGRES_DB=kashrutcrm_db
POSTGRES_USER=kasrut
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Redis requires this password (redis-server --requirepass); the api receives it
# inside REDIS_URL, so it must be URL-safe. Generate: openssl rand -hex 32
# Left empty on purpose: compose refuses to start until a real value is set.
REDIS_PASSWORD=

# The API refuses to start with a placeholder or low-entropy secret.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# All JWT signing keys are derived from it. Changing it signs nobody out: it
# voids access tokens (15 min) and 2FA sign-ins in progress, and clients renew
# through their refresh cookies. To end sessions, bump sessionVersion
# (docs/deployment/hetzner.md#sessions-and-refresh-cookies).
JWT_SECRET=replace-with-at-least-32-random-characters

# Sessions: 15-minute access tokens renewed by a rotating refresh cookie; a
# sign-in lasts 30 days however often it is renewed; cookies are Secure
# (production is HTTPS). These are the defaults; docker-compose.yml forwards
# the variables (see docs/deployment/hetzner.md#sessions-and-refresh-cookies).
# JWT_EXPIRES_IN is no longer read (and no longer forwarded): remove it.
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_SECURE=true

# AES-256-GCM key for 2FA secret encryption — must be exactly 64 hex characters
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-chars

CORS_ORIGINS=https://mykoshermap.com,https://crm.mykoshermap.com,https://api.mykoshermap.com

# Mandatory 2FA for CRM owners; the API defaults to true when unset. See
# docs/deployment/hetzner.md#mandatory-2fa-for-crm-owners before changing it.
# REQUIRE_OWNER_2FA=true

RUN_MIGRATIONS=true
SEED_DB=false

GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=https://mykoshermap.com/

# Mail server (map password resets and email verification, CRM expiry notices).
# With SMTP_HOST set, map email verification defaults to required;
# MAP_EMAIL_VERIFICATION=off is the rollback. docker-compose.yml forwards these
# (see docs/deployment/hetzner.md#map-email-verification).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAP_EMAIL_VERIFICATION=required
# MAP_PUBLIC_URL=https://mykoshermap.com

# Optional geocoders (server-side, api service only — no map rebuild, no CSP change).
# LocationIQ: key from https://locationiq.com/ (free tier ~5k/day). Empty → Nominatim.
LOCATIONIQ_API_KEY=
# GovMap (Survey of Israel): tried first for Israeli addresses. Token from the
# govmap.gov.il personal area (API management), bound to mykoshermap.com (+www).
# GOVMAP_ORIGIN defaults to https://mykoshermap.com. Empty key → LocationIQ/Nominatim only.
GOVMAP_API_KEY=

# ════════════════════════════════════════════════════════════════
#  KashrutCRM — пример переменных окружения
#  Скопируйте нужные блоки в соответствующие .env файлы
# ════════════════════════════════════════════════════════════════

# ─── kasrut-api/.env ─────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
EXPOSE_DEV_RESET_TOKEN=false

# Mandatory 2FA for CRM owners: until an owner enrols, the API allows only the
# 2FA setup calls (plus /auth/me and /auth/logout). Default: true.
REQUIRE_OWNER_2FA=true

# Public URL used in generated OpenAPI servers.
API_PUBLIC_URL=https://api.mykoshermap.com/api

# Минимум 32 случайных символа. Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# API не запустится с заглушкой или слабым значением: замените перед копированием.
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX

# Сессии: короткий access-токен (только в памяти клиента) + ротируемый refresh-токен
# в httpOnly-cookie. ACCESS_TOKEN_TTL: от 1m до 1h (15m / 900s / 1h), по умолчанию 15m.
# JWT_EXPIRES_IN больше не читается (API предупреждает при старте, если он задан).
ACCESS_TOKEN_TTL=15m
# Сколько дней после входа сессию можно продлевать через refresh-cookie (по умолчанию 30);
# ротация срок не продлевает.
REFRESH_TOKEN_TTL_DAYS=30
# Атрибут Secure у refresh-cookie: по умолчанию true, кроме NODE_ENV=development/test.
# COOKIE_SECURE=false

# 64 hex chars (32 bytes). Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Заглушка и шаблоны вроде 0123456789abcdef… отклоняются при запуске API.
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX

# Разрешённые CORS-источники (через запятую)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# PostgreSQL
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/kashrutcrm_db?schema=public

# Redis. A password-protected server takes it in the URL: redis://:PASSWORD@host:6379
# (the Docker Compose redis always requires REDIS_PASSWORD — see below; with its
# port published that is redis://:<REDIS_PASSWORD>@localhost:6380).
REDIS_URL=redis://localhost:6379

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# Map password-reset codes, map email verification links and CRM expiry
# notices. With SMTP_HOST empty, verification defaults to off and issues no
# links; password-reset and expiry mail is still attempted against localhost
# and fails in the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Map email verification for password registrations: 'required' lets a new
# account post reviews and suggestions only after it follows the emailed link;
# 'off' skips the check. Default: 'required' when SMTP_HOST is set, else 'off'.
# MAP_EMAIL_VERIFICATION=required
# Public map URL the verification link points to. Default: https://mykoshermap.com
MAP_PUBLIC_URL=http://localhost:5174

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Получить: https://console.developers.google.com/
#   Создать проект → APIs & Services → Credentials → OAuth 2.0 Client ID
#   Application type: Web application
#   Authorised JavaScript origins: http://localhost:5174
GOOGLE_CLIENT_ID=

# ─── Apple OAuth ─────────────────────────────────────────────────────────────
# Получить: https://developer.apple.com/account/resources/identifiers/list/serviceId
#   Identifiers → Services IDs → Register → Enable "Sign In with Apple"
#   Return URLs: http://localhost:5174/
APPLE_CLIENT_ID=

# ─── LocationIQ geocoding (optional) ─────────────────────────────────────────
# Primary geocoder for address→coords (suggest-a-place / re-geocode); falls back
# to Nominatim when empty. Get a free key at https://locationiq.com/ (self-serve,
# ~5k/day). LOCATIONIQ_ENDPOINT optional (default https://us1.locationiq.com).
LOCATIONIQ_API_KEY=
LOCATIONIQ_ENDPOINT=

# ─── GovMap geocoding (optional) ─────────────────────────────────────────────
# Survey of Israel search API, called server-side by kasrut-api as the first
# provider for Israeli addresses (then LocationIQ → Nominatim) and for the map's
# "correct my location" search. The token is issued in the govmap.gov.il personal
# area (API management) and bound to approved domains (mykoshermap.com + www); the
# API sends GOVMAP_ORIGIN as the Origin header (default https://mykoshermap.com).
# Leave GOVMAP_API_KEY empty to use LocationIQ/Nominatim only.
GOVMAP_API_KEY=
GOVMAP_ORIGIN=


# ─── kasrut-crm/.env ─────────────────────────────────────────────────────────

VITE_API_URL=http://localhost:3000/api
VITE_SENTRY_DSN=


# ─── kasrut-map/.env ─────────────────────────────────────────────────────────

VITE_API_URL=http://localhost:3000/api
VITE_SENTRY_DSN=

# Должен совпадать с Return URL в Apple Developer Console
VITE_APPLE_REDIRECT_URI=http://localhost:5174/


# ─── Docker Compose ──────────────────────────────────────────────────────────

NGINX_PORT=8080
POSTGRES_DB=kashrutcrm_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
REDIS_PORT=6380
# Required: redis-server runs with --requirepass and the api gets it inside
# REDIS_URL, so it must be URL-safe. Generate: openssl rand -hex 32
REDIS_PASSWORD=
RUN_MIGRATIONS=true
SEED_DB=false
# Required only when SEED_DB=true (16+ chars, upper/lowercase, digit, symbol)
SEED_OWNER_PASSWORD=
SEED_SECOND_OWNER_PASSWORD=
SEED_RABBANUT_PASSWORD=
SEED_MASHGIACH_PASSWORD=
# Destructive production seed requires an additional explicit opt-in.
ALLOW_PRODUCTION_SEED=false

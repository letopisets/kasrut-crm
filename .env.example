# Backend (kasrut-api/.env)
PORT=3000
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/kashrutcrm_db?schema=public
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Frontend (kasrut-crm/.env and kasrut-map/.env)
VITE_API_URL=http://localhost:3000/api
VITE_APPLE_REDIRECT_URI=http://localhost:5174/

# Docker compose overrides
NGINX_PORT=8080
POSTGRES_DB=kashrutcrm_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
REDIS_PORT=6380
RUN_MIGRATIONS=true
SEED_DB=false

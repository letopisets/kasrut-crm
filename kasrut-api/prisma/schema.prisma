generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  owner
  rabbanut
  mashgiach
}

enum CertStatus {
  ok
  warning
  critical
}

enum HechsherType {
  Rabbanut
  Badatz
  Mehadrin
  Private
}

enum InspectionResult {
  pending
  open
  pass
  fail
}

enum InspectionType {
  planned
  urgent
}

enum DocumentCategory {
  Instructions
  Forms
  Regulations
  Pesach
}

enum DocExt {
  PDF
  DOCX
  XLSX
}

enum FoodType {
  meat
  dairy
  pareve
  takeaway
}

enum MapAuthProvider {
  google
  apple
}

enum MapSuggestionType {
  add
  update
}

enum MapSuggestionStatus {
  pending
  approved
  rejected
}

enum MapPasswordResetChannel {
  email
  phone
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  passwordHash      String
  role              Role
  rabbanutId        String?
  twoFactorSecret   String?
  twoFactorEnabled  Boolean  @default(false)

  rabbanut          Rabbanut? @relation(fields: [rabbanutId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Rabbanut {
  id      String  @id @default(cuid())
  name    String
  city    String
  contact String
  phone   String
  email   String
  active  Boolean @default(true)
  color   String

  users        User[]
  hechsherim   Hechsher[]
  mashgichim   Mashgiach[]
  restaurants  Restaurant[]

  @@map("rabbanuts")
}

model Hechsher {
  id         String       @id @default(cuid())
  name       String
  shortName  String
  city       String
  contact    String
  phone      String
  email      String
  type       HechsherType
  color      String
  rabbanutId String

  rabbanut    Rabbanut    @relation(fields: [rabbanutId], references: [id], onDelete: Cascade)
  restaurants Restaurant[]
  mashgichim  MashgiachHechsher[]

  @@map("hechsherim")
}

model Mashgiach {
  id         String  @id @default(cuid())
  name       String
  phone      String
  email      String
  area       String
  active     Boolean @default(true)
  rabbanutId String

  rabbanut    Rabbanut  @relation(fields: [rabbanutId], references: [id], onDelete: Cascade)
  hechsherim  MashgiachHechsher[]
  restaurants Restaurant[]
  inspections Inspection[]

  @@map("mashgichim")
}

// Many-to-many: Mashgiach ↔ Hechsher
model MashgiachHechsher {
  mashgiachId String
  hechsherId  String

  mashgiach Mashgiach @relation(fields: [mashgiachId], references: [id], onDelete: Cascade)
  hechsher  Hechsher  @relation(fields: [hechsherId],  references: [id], onDelete: Cascade)

  @@id([mashgiachId, hechsherId])
  @@map("mashgiach_hechsher")
}

model Restaurant {
  id             String     @id @default(cuid())
  name           String
  address        String
  city           String
  level          String     // 'Regular' | 'Mehadrin'
  hechsherId     String
  mashgiachId    String?
  kitniyot       String
  expires        DateTime
  status         CertStatus @default(ok)
  rabbanutId     String
  notes          String?
  lastInspection DateTime?
  // Map fields
  lat            Float?
  lng            Float?
  foodType       FoodType   @default(pareve)
  phone          String?
  hours          String?

  hechsher    Hechsher    @relation(fields: [hechsherId],  references: [id])
  mashgiach   Mashgiach?  @relation(fields: [mashgiachId], references: [id], onDelete: SetNull)
  rabbanut    Rabbanut    @relation(fields: [rabbanutId],  references: [id], onDelete: Cascade)
  inspections Inspection[]
  mapSuggestions MapRestaurantSuggestion[]
  mapReviews     MapRestaurantReview[]

  @@index([lat, lng])
  @@index([city])
  @@index([foodType])
  @@index([hechsherId])
  @@map("restaurants")
}

model Inspection {
  id           String           @id @default(cuid())
  restaurantId String
  mashgiachId  String
  date         DateTime
  type         InspectionType
  result       InspectionResult @default(pending)
  notes        String?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  mashgiach  Mashgiach  @relation(fields: [mashgiachId],  references: [id])

  @@map("inspections")
}

model KashrutDocument {
  id       String           @id @default(cuid())
  name     String
  category DocumentCategory
  date     DateTime
  size     String
  ext      DocExt
  url      String?

  @@map("documents")
}

model MapUser {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  firstName    String?
  lastName     String?
  name         String
  avatarUrl    String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  identities  MapOAuthIdentity[]
  suggestions MapRestaurantSuggestion[]
  reviews     MapRestaurantReview[]
  resetTokens MapPasswordResetToken[]

  @@map("map_users")
}

model MapOAuthIdentity {
  id             String          @id @default(cuid())
  provider       MapAuthProvider
  providerUserId String
  mapUserId      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  mapUser MapUser @relation(fields: [mapUserId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([provider, mapUserId])
  @@map("map_oauth_identities")
}

model MapRestaurantSuggestion {
  id                    String              @id @default(cuid())
  type                  MapSuggestionType
  status                MapSuggestionStatus @default(pending)
  restaurantId          String?
  mapUserId             String
  proposedName          String?
  proposedAddress       String?
  proposedCity          String?
  proposedHechsher      String?
  proposedKashrutStatus String?
  proposedLat           Float?
  proposedLng           Float?
  notes                 String?
  reviewerNote          String?
  reviewedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  mapUser    MapUser     @relation(fields: [mapUserId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([mapUserId])
  @@index([restaurantId])
  @@index([status])
  @@map("map_restaurant_suggestions")
}

model MapRestaurantReview {
  id           String   @id @default(cuid())
  restaurantId String
  mapUserId    String
  rating       Int
  text         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mapUser    MapUser    @relation(fields: [mapUserId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, mapUserId])
  @@index([restaurantId])
  @@index([mapUserId])
  @@map("map_restaurant_reviews")
}

model MapPasswordResetToken {
  id        String                  @id @default(cuid())
  mapUserId String
  channel   MapPasswordResetChannel
  tokenHash String                  @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                @default(now())

  mapUser MapUser @relation(fields: [mapUserId], references: [id], onDelete: Cascade)

  @@index([mapUserId])
  @@index([expiresAt])
  @@map("map_password_reset_tokens")
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  owner
  rabbanut
  mashgiach
}

enum HechsherType {
  Rabbanut
  Badatz
  Mehadrin
  Private
}

enum InspectionResult {
  pending
  open
  pass
  fail
}

enum InspectionType {
  planned
  urgent
}

enum DocumentCategory {
  Instructions
  Forms
  Regulations
  Pesach
}

enum DocExt {
  PDF
  DOCX
  XLSX
}

enum FoodType {
  meat
  dairy
  pareve
  takeaway
}

// How trustworthy a restaurant's lat/lng is. Imported rows are placed at the
// city centre with jitter (approximate); geocoding or a manual map correction
// upgrades them to exact.
enum GeoAccuracy {
  exact
  approximate
}

enum MapAuthProvider {
  google
  apple
}

enum MapSuggestionType {
  add
  update
}

enum MapSuggestionStatus {
  pending
  approved
  rejected
}

enum MapPasswordResetChannel {
  email
  phone
}

enum SettlementType {
  city
  town
  village
  suburb
  neighbourhood
  quarter
  other
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  passwordHash         String
  role                 Role
  rabbanutId           String?
  twoFactorSecret      String?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorBackupCodes String[]  @default([])
  passwordChangedAt    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  rabbanut Rabbanut? @relation(fields: [rabbanutId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Rabbanut {
  id           String    @id @default(cuid())
  name         String
  city         String
  contact      String
  phone        String
  email        String
  active       Boolean   @default(true)
  color        String
  settlementId String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  users        User[]
  hechsherim   Hechsher[]
  mashgichim   Mashgiach[]
  restaurants  Restaurant[]
  settlement   Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@map("rabbanuts")
}

model Hechsher {
  id           String       @id @default(cuid())
  name         String
  shortName    String
  city         String
  contact      String
  phone        String
  email        String
  type         HechsherType
  color        String
  rabbanutId   String
  active       Boolean      @default(true)
  settlementId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  rabbanut    Rabbanut    @relation(fields: [rabbanutId], references: [id], onDelete: Cascade)
  settlement  Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  restaurants Restaurant[]
  mashgichim  MashgiachHechsher[]

  @@map("hechsherim")
}

model Mashgiach {
  id         String   @id @default(cuid())
  name       String
  phone      String
  email      String
  area       String
  active     Boolean  @default(true)
  rabbanutId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  rabbanut    Rabbanut  @relation(fields: [rabbanutId], references: [id], onDelete: Cascade)
  hechsherim  MashgiachHechsher[]
  restaurants Restaurant[]
  inspections Inspection[]

  @@map("mashgichim")
}

// Many-to-many: Mashgiach ↔ Hechsher
model MashgiachHechsher {
  mashgiachId String
  hechsherId  String

  mashgiach Mashgiach @relation(fields: [mashgiachId], references: [id], onDelete: Cascade)
  hechsher  Hechsher  @relation(fields: [hechsherId],  references: [id], onDelete: Cascade)

  @@id([mashgiachId, hechsherId])
  @@map("mashgiach_hechsher")
}

model KashrutLevel {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  sortOrder   Int     @default(0)

  restaurants Restaurant[]

  @@map("kashrut_levels")
}

model EstablishmentCategory {
  id     String  @id @default(cuid())
  slug   String  @unique
  nameHe String
  nameEn String?
  nameRu String?

  restaurants Restaurant[]

  @@map("establishment_categories")
}

model Restaurant {
  id             String     @id @default(cuid())
  name           String
  address        String
  city           String
  levelId        String
  hechsherId     String
  mashgiachId    String?
  kitniyot       Boolean    @default(false)
  expires        DateTime
  rabbanutId     String
  notes          String?
  categoryId     String?
  settlementId   String?
  deletedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  // Map fields
  lat               Float?
  lng               Float?
  geoAccuracy       GeoAccuracy @default(approximate)
  geocodeAttemptedAt DateTime?  // last address-geocode attempt (re-geocode job)
  foodType       FoodType   @default(pareve)
  phone          String?
  hours          String?

  level       KashrutLevel          @relation(fields: [levelId],      references: [id], onDelete: Restrict)
  hechsher    Hechsher              @relation(fields: [hechsherId],   references: [id], onDelete: Restrict)
  mashgiach   Mashgiach?            @relation(fields: [mashgiachId],  references: [id], onDelete: SetNull)
  rabbanut    Rabbanut              @relation(fields: [rabbanutId],   references: [id], onDelete: Cascade)
  settlement  Settlement?           @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  category    EstablishmentCategory? @relation(fields: [categoryId],  references: [id], onDelete: SetNull)
  inspections    Inspection[]
  mapSuggestions MapRestaurantSuggestion[]
  mapReviews     MapRestaurantReview[]

  @@index([lat, lng])
  @@index([city])
  @@index([foodType])
  @@index([levelId])
  @@index([hechsherId])
  @@index([mashgiachId])
  @@index([rabbanutId])
  @@index([expires])
  @@index([deletedAt])
  @@index([categoryId])
  @@map("restaurants")
}

model Inspection {
  id           String           @id @default(cuid())
  restaurantId String
  mashgiachId  String?
  date         DateTime
  type         InspectionType
  result       InspectionResult @default(pending)
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  mashgiach  Mashgiach?  @relation(fields: [mashgiachId],  references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([mashgiachId])
  @@index([date])
  @@index([restaurantId, date])
  @@map("inspections")
}

model KashrutDocument {
  id        String           @id @default(cuid())
  name      String
  category  DocumentCategory
  date      DateTime
  size      BigInt           @default(0)
  ext       DocExt
  url       String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("documents")
}

model Country {
  code        String       @id @db.Char(2)
  nameEn      String
  settlements Settlement[]

  @@map("countries")
}

model Settlement {
  id          String  @id @default(uuid())
  nameHe      String
  nameEn      String?
  nameRu      String?
  lat         Float?
  lng         Float?
  type        SettlementType  @default(city)
  countryCode String  @db.Char(2)

  country     Country      @relation(fields: [countryCode], references: [code])
  restaurants Restaurant[]
  hechsherim  Hechsher[]
  rabbanuts   Rabbanut[]

  @@index([nameHe])
  @@index([nameEn])
  @@index([nameRu])
  @@map("settlements")
}

model ServiceLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  level      String
  service    String
  action     String?
  message    String
  userId     String?
  userEmail  String?
  userRole   String?
  entityType String?
  entityId   String?
  method     String?
  path       String?
  statusCode Int?
  requestId  String?
  metadata   Json?

  @@index([createdAt])
  @@index([level])
  @@index([service])
  @@index([userId])
  @@map("service_logs")
}

model MapUser {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  firstName    String?
  lastName     String?
  name         String
  avatarUrl    String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  identities  MapOAuthIdentity[]
  suggestions MapRestaurantSuggestion[]
  reviews     MapRestaurantReview[]
  resetTokens MapPasswordResetToken[]

  @@map("map_users")
}

model MapOAuthIdentity {
  id             String          @id @default(cuid())
  provider       MapAuthProvider
  providerUserId String
  mapUserId      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  mapUser MapUser @relation(fields: [mapUserId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([provider, mapUserId])
  @@map("map_oauth_identities")
}

model MapRestaurantSuggestion {
  id                    String              @id @default(cuid())
  type                  MapSuggestionType
  status                MapSuggestionStatus @default(pending)
  restaurantId          String?
  mapUserId             String
  proposedName          String?
  proposedAddress       String?
  proposedCity          String?
  proposedHechsher      String?
  proposedKashrutStatus String?
  proposedFoodType      FoodType?
  proposedCategory      String?   // EstablishmentCategory.slug — вид заведения
  proposedImageUrl      String?
  proposedLat           Float?
  proposedLng           Float?
  notes                 String?
  reviewerNote          String?
  reviewedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  mapUser    MapUser     @relation(fields: [mapUserId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([mapUserId])
  @@index([restaurantId])
  @@index([status])
  @@map("map_restaurant_suggestions")
}

model MapRestaurantReview {
  id           String   @id @default(cuid())
  restaurantId String
  mapUserId    String
  rating       Int
  text         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mapUser    MapUser    @relation(fields: [mapUserId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, mapUserId])
  @@index([restaurantId])
  @@index([mapUserId])
  @@map("map_restaurant_reviews")
}

model MapPasswordResetToken {
  id        String                  @id @default(cuid())
  mapUserId String
  channel   MapPasswordResetChannel
  tokenHash String                  @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                @default(now())

  mapUser MapUser @relation(fields: [mapUserId], references: [id], onDelete: Cascade)

  @@index([mapUserId])
  @@index([expiresAt])
  @@map("map_password_reset_tokens")
}

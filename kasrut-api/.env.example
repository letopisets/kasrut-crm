# ─────────────────────────────────────────────────────────────────────────────
# KashrutCRM API — environment variables template
# Copy to .env and fill in real values. NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# Never expose password-reset tokens unless explicitly debugging locally.
EXPOSE_DEV_RESET_TOKEN=false

# Mandatory 2FA for CRM owners (global admins). Until an owner enrols, the API
# allows only /auth/me, /auth/logout and the 2FA setup calls; owners cannot
# switch 2FA off. Default: true.
REQUIRE_OWNER_2FA=true

# JWT — minimum 32 characters, use: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Placeholders and low-entropy values are rejected at startup. Per-purpose
# signing keys are derived from it. Changing it signs nobody out: it voids
# access tokens and 2FA sign-ins in progress, and clients renew through their
# refresh cookies; bump sessionVersion to end sessions (see hetzner.md).
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX

# Sessions: short-lived access tokens (kept in memory by the CRM and the map)
# renewed through a rotating refresh token in an httpOnly cookie.
# ACCESS_TOKEN_TTL: 1m-1h, written as 15m / 900s / 1h. Default: 15m.
# JWT_EXPIRES_IN is no longer read; the API warns at startup while it is set.
ACCESS_TOKEN_TTL=15m
# Days a sign-in can be renewed through the refresh cookie; rotation does not
# extend it. Default: 30.
REFRESH_TOKEN_TTL_DAYS=30
# Secure attribute of the refresh cookies. Default: true, except when NODE_ENV
# is development or test (plain http on localhost).
# COOKIE_SECURE=false

# AES-256-GCM key for encrypting 2FA secrets at rest.
# Must be exactly 64 hex characters (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX

# Database — use a dedicated non-superuser account in production
DATABASE_URL="postgresql://kashrut_user:STRONG_PASSWORD@localhost:5432/kashrutcrm_db?schema=public"

# Redis — a password goes in the URL: redis://:PASSWORD@localhost:6379
# (the Docker Compose redis always requires one; keep it URL-safe: openssl rand -hex 32)
REDIS_URL=redis://localhost:6379

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# SMTP for map password-reset codes, map email verification links and CRM
# expiry notices. Empty SMTP_HOST: verification defaults to off and issues no
# links, but password-reset and expiry mail is still attempted against
# localhost (and fails in the log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Map email verification for password registrations. 'required': reviews and
# suggestions only after the emailed link is followed; 'off': no check.
# Default: 'required' when SMTP_HOST is set, otherwise 'off' (the API warns at
# startup in production). OAuth accounts are always verified.
# MAP_EMAIL_VERIFICATION=required
# Public map URL, used in the verification link, the sitemap and the
# prerendered pages. Default: https://mykoshermap.com
MAP_PUBLIC_URL=http://localhost:5174

# Google OAuth (restrict to your domain in Google Cloud Console)
GOOGLE_CLIENT_ID=

# Apple OAuth
APPLE_CLIENT_ID=

# LocationIQ geocoding (optional) — primary geocoder when set, else Nominatim.
# Free key at https://locationiq.com/. LOCATIONIQ_ENDPOINT defaults to https://us1.locationiq.com.
LOCATIONIQ_API_KEY=
# LOCATIONIQ_ENDPOINT=

# GovMap geocoding (optional) — Survey of Israel search API, tried first for
# Israeli addresses and used by /api/map/places. The token is bound to the
# approved domain; requests carry GOVMAP_ORIGIN as the Origin header, so keep the
# production domain even in local dev. Empty → LocationIQ/Nominatim only.
GOVMAP_API_KEY=
# GOVMAP_ORIGIN=https://mykoshermap.com
